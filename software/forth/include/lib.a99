        .def setjmp
setjmp:
        MOV r0, *r1+
                                        ;Note r1 is param, ignored
        MOV r2, *r1+
        MOV r3, *r1+
        MOV r4, *r1+
        MOV r5, *r1+
        MOV r6, *r1+
        MOV r7, *r1+
        MOV r8, *r1+
        MOV r9, *r1+
        MOV r10, *r1+
        MOV r11, *r1+                   ;also PC
        MOV r12, *r1+
        MOV r13, *r1+
        MOV r14, *r1+
        MOV r15, *r1+
        LI r1, >0
        B *r11

        .def longjmp
longjmp:
        MOV r1, r15                     ;Pointer to struct
        MOV r2, r1                      ;return value to R1

        MOV *r15+, r0
                                        ;r1 skipped
        MOV *r15+, r2
        MOV *r15+, r3
        MOV *r15+, r4
        MOV *r15+, r5
        MOV *r15+, r6
        MOV *r15+, r7
        MOV *r15+, r8
        MOV *r15+, r9
        MOV *r15+, r10
        MOV *r15+, r11                  ;also PC
        MOV *r15+, r12
        MOV *r15+, r13
        MOV *r15+, r14
        MOV *r15, r15
        B *r11