MUX0    EQU >F000
M0STAT  EQU >F000                       ;  Read status: bit 0 = Transmit Busy, bit 1 = Data Received
M0RX    EQU >F002                       ;  Read byte received in 8 LSB
M0RXB   EQU >F003                       ;  Read byte received
M0TX    EQU >F004                       ;  Write byte to send in 8 LSB
M0TXB   EQU >F005                       ;  Write byte to send
M0RST   EQU >F006                       ;  Write to reset interrupt and Data Received status
M0IRQ   EQU >2                          ;  IRQ for Mux0

                                        ; Mux1 constants
MUX1    EQU >F008
M1STAT  EQU >F008
M1RX    EQU >F00A
M1RXB   EQU >F00B
M1TX    EQU >F00C
M1TXB   EQU >F00D
M1RST   EQU >F00E
M1IRQ   EQU >3
