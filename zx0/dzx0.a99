; -----------------------------------------------------------------------------
; ZX0 decoder for TMS9900
; Based on Z80 "Standard" version by Einar Saukas & Urusergi
; Ported for TMS9900 architecture
; -----------------------------------------------------------------------------
; Usage:
;   LI   R0,COMPRESSED_ADDR     ; Source address (compressed data in ROM)
;   LI   R1,DEST_ADDR           ; Destination address (RAM)
;   BL   @DZX0
;   ; On return: R1 points to byte after last decompressed byte
; -----------------------------------------------------------------------------
; Register usage:
;   R0:  Input Pointer
;   R1:  Output Pointer
;   R2:  Bit value (current byte being read bit-by-bit)
;   R3:  Bit mask (0x8000, 0x4000, ... 0x0100, then refill)
;   R4:  Backtrack
;   R5:  Last Byte
;   R6: last_offset
;   R7: length
;   R8: i
;   R9 Elias return
;   R12: 1 for inverted elias, 0 for normal
;   R15: Read bit return
; Scratch R15, R14, R13
; -----------------------------------------------------------------------------

                                        ; Uses R13 as scratch
DZX0
        MOV R11, R13
        LI R6, >1                       ;last_offset = INITIAL_OFFSET = 1
        LI R3, >0080                    ;bit mask = 0
        CLR R4                          ;backtrack = 0
        CLR R12
COPY_LITERALS:
        BL @ELIAS
LIT_LOOP:
        MOVB *R0+, *R1+                 ; *output_ptr++ = *input_ptr++
        DEC R9
        JNE LIT_LOOP

        BL @READBIT                     ;if (read_bit())
        JNE NEW_OFFSET                  ;       goto COPY_FROM_NEW_OFFSET;

                                        ;Uses R15 as scratch
LAST_OFFSET:
        BL @ELIAS

        BL @WRITE_OFFSET

        BL @READBIT                     ;if (!read_bit())
        JEQ COPY_LITERALS               ;       goto COPY_LITERALS;

                                        ;Uses R15 as scratch
NEW_OFFSET
        INC R12                         ;Inverted!
        BL @ELIAS
        CLR R12

        CI R9, >0100                    ; Done condition
        JEQ DZX_DONE

        MOV R9, R6                      ;last_offset = read_interlaced_elias_gamma(1);
        MOVB *R0+, R5                   ;last_byte = *input_ptr++;

                                        ;last_offset = last_offset * 128 - (last_byte >> 1);
        SLA R6, 7                       ;last_offset = last_offset * 128
        MOV R5, R15                     ; R15 = last_byte
        SWPB R15
        SRL R15, 1                      ; R15 = last_byte >> 1
        S R15, R6                       ;last_offset = last_offset * 128 - (last_byte >> 1);

        LI R4, 1                        ;backtrack = 1

        BL @ELIAS
        INC R9                          ; R9 length = read_interlaced_elias_gamma(0) + 1;
        BL @WRITE_OFFSET

        BL @READBIT
        JNE NEW_OFFSET
        JMP COPY_LITERALS
DZX_DONE
        B *R13

                                        ;Uses R15 as Scratch & Return Value
WRITE_OFFSET                            ;Leaf function, no need to store R11
        MOV R1, R15                     ; R6 = current output_ptr
        S R6, R15                       ; R6 = output_ptr - last_offset
WRITE_OFFSET_LOOP:
        MOVB *R15+, *R1+                ; *output_ptr++ = *(output_ptr - offset)++
        DEC R9
        JNE WRITE_OFFSET_LOOP
        B *R11


                                        ;Uses R15 as Scratch & Return Value
READBIT                                 ;Leaf function, no need to store R11
        MOV R4, R4
        JEQ READBIT_NO_BACKTRACK
        CLR R4
        MOV R5, R15
        ANDI R15, >0100
        B *R11
READBIT_NO_BACKTRACK
        CI R3, >0080                    ;Has the bit fallen off the high bit?
        JNE READBIT_HAVE_BYTE           ; if not there are still bits left to read
        MOVB *R0+, R2                   ;read the new byte
        LI R3, >8000                    ;reset the bit mask
READBIT_HAVE_BYTE
        CLR R15                         ;Prepare to return zero
        COC R3, R2                      ;Check byte vs mask
        JNE READBIT_ZERO                ;Jump to zero return
        INC R15                         ;Change return to one
READBIT_ZERO
        SRL R3, 1                       ;Shift mask
        MOV R15, R15                    ;Reload return value so callers can just use EQ status bit
        B *R11

                                        ;Uses R14 as scratch
                                        ;Retrns in R9
ELIAS
        MOV R11, R14                    ; Save return address
        LI R9, 1                        ; value = 1
ELIAS_LOOP
        BL @READBIT                     ; Read data bit
        JNE ELIAS_DONE                  ; If bit=1, done
                                        ; Data bit was 0, continue
        SLA R9, 1                       ; value <<= 1
        BL @READBIT                     ; Read value bit
        XOR R12, R15                    ; possibly invert the one bit
        A R15, R9                       ; R15 is 1 or zero, add it
        JMP ELIAS_LOOP
ELIAS_DONE
        B *R14