M0STAT  EQU >F000                       ;  Read status: bit 0 = Transmit Busy, bit 1 = Data Received
M0RX    EQU >F002                       ;  Read byte received in 8 LSB
M0TX    EQU >F004                       ;  Write byte to send in 8 LSB
M0TXB   EQU >F005                       ;  Write byte to send in 8 LSB
M0RST   EQU >F006                       ;  Write to reset interrupt and Data Received status

        AORG >0000                      ; Reset Vector...
        DATA WP                      ;       OS workspace addr
        DATA START                         ;       Init code

        SAVE >2000,
        AORG >2000
START
        LI R1, STR                      ;Load str addr to R1
NEXT
        MOVB *R1+, R2                    ;Load next char
        JEQ START                       ;if null restart
WAIT    MOV @M0STAT, R0                 ;Load Mux status
        JNE WAIT                        ;keep waiting if non zer0
        MOVB R2, @M0TXB                    ;Send byte
        JMP NEXT

STR     TEXT "Hello Compressed World! Hello Compression!"
        BYTE 13, 10, 0


        DORG >1000
WP      BSS 32

