XAS99 CROSS-ASSEMBLER   VERSION 3.6.5
     **** ****     > serialInt.a99
0001                       COPY "../../software/mux.a99"
     **** ****     > ../../software/mux.a99
0001      F000     MUX0    EQU >F000
0002      F000     M0STAT  EQU >F000                       ;  Read status: bit 0 = Transmit Busy, bit 1 = Data Received
0003      F002     M0RX    EQU >F002                       ;  Read byte received in 8 LSB
0004      F003     M0RXB   EQU >F003                       ;  Read byte received
0005      F004     M0TX    EQU >F004                       ;  Write byte to send in 8 LSB
0006      F005     M0TXB   EQU >F005                       ;  Write byte to send
0007      F006     M0RST   EQU >F006                       ;  Write to reset interrupt and Data Received status
0008      0002     M0IRQ   EQU >2                          ;  IRQ for Mux0
0009               
0010                                                       ; Mux1 constants
0011      F008     MUX1    EQU >F008
0012      F008     M1STAT  EQU >F008
0013      F00A     M1RX    EQU >F00A
0014      F00B     M1RXB   EQU >F00B
0015      F00C     M1TX    EQU >F00C
0016      F00D     M1TXB   EQU >F00D
0017      F00E     M1RST   EQU >F00E
0018      0003     M1IRQ   EQU >3
                   < serialInt.a99
0002                       COPY "../../software/addrs.a99"
     **** ****     > ../../software/addrs.a99
0001      0000     VECTORS EQU >0000
0002      0040     TRAPS   EQU >0040
0003      0080     GENERAL EQU >0080
0004      1000     RAM_START EQU >1000
0005      3FFE     RAM_END EQU >3FFE
                   < serialInt.a99
0003               
0004      0004     TMRIRQ  EQU >4                          ; Timer IRQ
0005      F010     TMRRST  EQU >F010
0006               
0007               
0008               ;*************************************************
0009               ;                       Scheduler RAM
0010               
0011                       DORG >1000                      ; RAM start
0012 1000          OSWP    BSS 32                          ; Set aside 32 bytes/16 words for primary workspace
0013               
0014               TCBS                                    ; Start of TCB Table
0015 1020                  BSS 6                           ; WP,PC,ST
0016 1026                  BSS 6
0017               TCBE                                    ; End of TCB Table
0018               
0019 102C          TCUR    BSS 2                           ; Pointer to TCB for current task
0020               
0021 102E          M0TXP   BSS 2                           ;Mux 0 TX Pointer
0022 1030          M0RXD   BSS 2                           ;Mux 0 RX Byte
0023 1032          M1TXP   BSS 2                           ;Mux 1 TX Pointer
0024 1034          M1RXD   BSS 2                           ;Mux 1 RX Byte
0025               
0026               ;*************************************************
0027               ;                       ROM Start
0028                       AORG >0000                      ; Reset Vector...
0029 0000 1000             DATA OSWP                       ;       OS workspace addr
0030 0002 010C             DATA INIT                       ;       Init code
0031               
0032               M0IRQV  AORG M0IRQ * 4
0033 0008 1000             DATA OSWP
0034 000A 0152             DATA MUX0ISR
0035               
0036               M1IRQV  AORG M1IRQ * 4
0037 000C 1000             DATA OSWP
0038 000E 0160             DATA MUX1ISR
0039               
0040               TIMERV  AORG TMRIRQ * 4                 ; Timer Vector
0041 0010 1000             DATA OSWP                       ;       OS Workspace
0042 0012 0124             DATA TIMERISR                   ;       Scheduler code
0043               
0044                       AORG >0100
0045               INITDATA                                ; Initial Ram Values
0046 0100 2000             DATA T1RAM, TOP1, >0008         ; Task 1 TCB
     0102 0200     
     0104 0008     
0047 0106 3000             DATA T2RAM, TOP2, >0008         ; Task 2 TCB
     0108 0300     
     010A 0008     
0048               INITEND
0049               
0050               INIT
0051 010C 0200  12         LI R0, INITDATA                 ; Copy TCBs from ROM to RAM
     010E 0100     
0052 0110 0201  12         LI R1, TCBS
     0112 1020     
0053 0114 0202  12         LI R2, (INITEND-INITDATA)/2
     0116 0006     
0054 0118 CC70  42 COPYD   MOV *R0+, *R1+
0055 011A 0602  10         DEC R2
0056 011C 16FD  10         JNE COPYD
0057               
0058                                                       ; Load and run Task 1
0059 011E 0201  12         LI R1, TCBS                     ; Set the first task as the "next" to run
     0120 1020     
0060 0122 1011  10         JMP RES                         ; Jump straight to resume it!
0061               
0062               
0063               TIMERISR
0064 0124 0300  14         LIMI 0                          ; INT OFF
     0126 0000     
0065 0128 04E0  26         CLR @TMRRST                     ; MMIO Write to clear timer interrupt
     012A F010     
0066               
0067 012C C020  22         MOV @TCUR, R0                   ;Load current TCB address to R0
     012E 102C     
0068 0130 C040  14         MOV R0, R1                      ;Copy to R1...
0069 0132 0221  14         AI R1, >6                       ;and increment to next TCB
     0134 0006     
0070               
0071                                                       ;Loop back around to the first task
0072 0136 0281  14         CI R1, TCBE                     ;If next task is NOT past the end of the TCB Table
     0138 102C     
0073 013A 1602  10         JNE SWAP                        ;THEN goto SWAP
0074 013C 0201  12         LI R1, TCBS                     ;ELSE set it to the first one
     013E 1020     
0075               SWAP
0076               
0077               SUS                                     ;Suspend task to TCB in R0
0078 0140 CC0D  30         MOV R13, *R0+                   ; Save context to TCB
0079 0142 CC0E  30         MOV R14, *R0+
0080 0144 CC0F  30         MOV R15, *R0+
0081               RES                                     ;Resume task from TCB in R1
0082 0146 C801  22         MOV R1, @TCUR                   ; Save as current task
     0148 102C     
0083 014A C371  26         MOV *R1+, R13                   ; Restore context from TCB
0084 014C C3B1  26         MOV *R1+, R14
0085 014E C3F1  26         MOV *R1+, R15
0086 0150 0380  14         RTWP
0087               
0088               MUX0ISR
0089 0152 0300  14         LIMI 0
     0154 0000     
0090 0156 0204  12         LI R4, M0TXP
     0158 102E     
0091 015A 0201  12         LI R1, M0STAT
     015C F000     
0092 015E 1006  10         JMP MUXTX
0093               
0094               MUX1ISR
0095 0160 0300  14         LIMI 0
     0162 0000     
0096 0164 0204  12         LI R4, M1TXP
     0166 1032     
0097 0168 0201  12         LI R1, M1STAT
     016A F008     
0098               
0099               MUXTX
0100 016C C0D1  22         MOV *R1, R3                     ;Load mux status
0101 016E 04E1  26         CLR @6(R1)                      ;Clear IRQ      //TODO Dont clear till after read?
     0170 0006     
0102 0172 C083  14         MOV R3, R2
0103 0174 0242  14         ANDI R2, >0001                  ;Transmit busy?
     0176 0001     
0104 0178 1609  10         JNE MUXRX                       ;If so go to RX
0105                                                       ;Ready to transmit
0106 017A C094  22         MOV *R4, R2                     ;Load TX Pointer
0107 017C 1307  10         JEQ MUXRX                       ;Nothing to transmit? goto RX
0108 017E D172  24         MOVB *R2+, R5                   ;Load transmit data and increment pointer
0109 0180 1304  10         JEQ DONE                        ;Null? done!
0110 0182 D845  30         MOVB R5, @5(R1)                 ;Transmit
     0184 0005     
0111 0186 C502  26         MOV R2, *R4                     ;Store incremented poiter
0112 0188 1001  10         JMP MUXRX
0113               DONE
0114 018A 04D4  22         CLR *R4                         ;Clear transmit pointer
0115               MUXRX
0116 018C C083  14         MOV R3, R2
0117 018E 0242  14         ANDI R2, >0002                  ;Byte received ??
     0190 0002     
0118 0192 1303  10         JEQ RET
0119 0194 C921  42         MOV @2(R1), @2(R4)
     0196 0002     
     0198 0002     
0120 019A 0380  14 RET     RTWP
0121               
0122               
0123               ;*************************************************
0124               ;                       Task 1
0125                       DORG >2000
0126 2000          T1RAM   BSS 32                          ;Workspace
0127                       AORG >0200
0128 0200 0202  12 TOP1    LI R2, STR1                     ; Store the text address in R1
     0202 021A     
0129 0204 C802  22         MOV R2, @M0TXP
     0206 102E     
0130 0208 0420  34         BLWP @M0IRQV                    ; trigger transmit
     020A 0008     
0131 020C C000  14         MOV R0, R0
0132               LOOP1                                   ;Wait for tx to complete
0133 020E 0420  34         BLWP @TIMERV                    ; yield
     0210 0010     
0134 0212 C0A0  22         MOV @M0TXP, R2                  ;Load data pointer
     0214 102E     
0135 0216 16FB  10         JNE LOOP1                       ;if not zero yet keep waiting
0136 0218 10F3  10         JMP TOP1
0137 021A 4845     STR1    TEXT "HELLORLD!"
     021C 4C4C     
     021E 4F52     
     0220 4C44     
     0222 21       
0138 0223   0D             BYTE 13, 10, 0
     0224 0A00     
0139               
0140               ;*************************************************
0141               ;                       Task 2
0142                       DORG >3000
0143 3000          T2RAM   BSS 32                          ;Workspace
0144 3020          T2BUF   BSS 2
0145                       AORG >0300
0146 0300 0202  12 TOP2    LI R2, STR2                     ; Store the text address in R1
     0302 0332     
0147 0304 C802  22         MOV R2, @M1TXP
     0306 1032     
0148 0308 0420  34         BLWP @M1IRQV                    ; trigger transmit
     030A 000C     
0149               
0150               LOOP2                                   ;Wait for RX Byte
0151 030C 0420  34         BLWP @TIMERV                    ; yield
     030E 0010     
0152 0310 C260  22         MOV @M1RXD, R9                  ; Load RX Byte
     0312 1034     
0153 0314 13FB  10         JEQ LOOP2                       ; If zero loop
0154               
0155 0316 04E0  26         CLR @T2BUF                      ; Clear transmit buf
     0318 3020     
0156 031A D820  38         MOVB @M1RXD+1, @T2BUF           ; Move rx byte into transmit buf
     031C 1035     
     031E 3020     
0157                                                       ; Note second byte of word is the null
0158 0320 04E0  18         CLR @M1RXD                      ; Clear receive byte
     0322 1034     
0159               
0160 0324 0202  12         LI R2, T2BUF                    ; Store the text address in R1
     0326 3020     
0161 0328 C802  22         MOV R2, @M1TXP
     032A 1032     
0162 032C 0420  34         BLWP @M1IRQV                    ; trigger transmit
     032E 000C     
0163 0330 10ED  10         JMP LOOP2                       ; Start over
0164               
0165 0332 4865     STR2    TEXT "Hello Packed String, Hello Interupt IO, this terminal echos..."
     0334 6C6C     
     0336 6F20     
     0338 5061     
     033A 636B     
     033C 6564     
     033E 2053     
     0340 7472     
