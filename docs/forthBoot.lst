XAS99 CROSS-ASSEMBLER   VERSION 3.6.5
     **** ****     > boot.a99
0001                       COPY "../mux.a99"
     **** ****     > ../mux.a99
0001      F000     MUX0    EQU >F000
0002      F000     M0STAT  EQU >F000                       ;  Read status: bit 0 = Transmit Busy, bit 1 = Data Received
0003      F002     M0RX    EQU >F002                       ;  Read byte received in 8 LSB
0004      F003     M0RXB   EQU >F003                       ;  Read byte received
0005      F004     M0TX    EQU >F004                       ;  Write byte to send in 8 LSB
0006      F005     M0TXB   EQU >F005                       ;  Write byte to send
0007      F006     M0RST   EQU >F006                       ;  Write to reset interrupt and Data Received status
0008      0003     M0IRQ   EQU >3                          ;  IRQ for Mux0
0009               
0010                                                       ; Mux1 constants
0011      F00A     MUX1    EQU >F00A
0012      F00A     M1STAT  EQU >F00A
0013      F00C     M1RX    EQU >F00C
0014      F00D     M1RXB   EQU >F00D
0015      F00E     M1TX    EQU >F00E
0016      F00F     M1TXB   EQU >F00F
0017      F010     M1RST   EQU >F010
0018      0004     M1IRQ   EQU >4
                   < boot.a99
0002                       COPY "../addrs.a99"
     **** ****     > ../addrs.a99
0001      0000     VECTORS EQU >0000
0002      0040     TRAPS   EQU >0040
0003      0080     GENERAL EQU >0080
0004      1000     RAM_START EQU >1000
0005      3FFE     RAM_END EQU >3FFE
                   < boot.a99
0003               
0004      0001     TMRIRQ  EQU >1                          ; Timer IRQ
0005      F0F0     TMRRST  EQU >F0F0
0006               
0007               ;*************************************************
0008               ;                       Stacks
0009      3ED0     T0_SP   EQU >4000 - >130
0010      3410     T1_SP   EQU >3410
0011               
0012                       DORG >4000 - 128
0013               ;*************************************************
0014               ;                       Task Workspaces
0015 3F80          T0_WP   BSS 32
0016 3FA0          T1_WP   BSS 32
0017               
0018               ;*************************************************
0019               ;                       Scheduler RAM
0020 3FC0          OSWP    BSS 32                          ; Set aside 32 bytes/16 words for primary workspace
0021               
0022               TCBS                                    ; Start of TCB Table
0023 3FE0                  BSS 6                           ; WP,PC,ST
0024 3FE6                  BSS 6
0025               TCBE                                    ; End of TCB Table
0026               
0027 3FEC          TCUR    BSS 2                           ; Pointer to TCB for current task
0028               
0029 3FEE          M0TXP   BSS 2                           ;Mux 0 TX Pointer
0030 3FF0          M0RXD   BSS 2                           ;Mux 0 RX Byte
0031 3FF2          M1TXP   BSS 2                           ;Mux 1 TX Pointer
0032 3FF4          M1RXD   BSS 2                           ;Mux 1 RX Byte
0033               
0034               ;*************************************************
0035               ;                       ROM Start
0036                       AORG >0000                      ; Reset Vector...
0037 0000 3FC0             DATA OSWP                       ;       OS workspace addr
0038 0002 007A             DATA UNZIP                      ;       Init code
0039               
0040               TIMERV  AORG TMRIRQ * 4                 ; Timer Vector
0041 0004 3FC0             DATA OSWP                       ;       OS Workspace
0042 0006 004C             DATA ISR_TIMER                  ;       Scheduler code
0043               
0044               ;M0IRQV  AORG M0IRQ * 4
0045               ;        DATA OSWP
0046               ;        DATA ISR_MUX_0
0047               
0048               ;M1IRQV  AORG M1IRQ * 4
0049               ;        DATA OSWP
0050               ;        DATA ISR_MUX_1
0051               
0052               
0053               ;*************************************************
0054               ;                       TCB Initialization
0055               TCB_INIT_DATA                           ; Initial Ram Values
0056 0008 3F80             DATA T0_WP, UNZIP_DATA, >0001   ; Task 0 TCB //TODO FIX INT MASK!!!
     000A 1000     
     000C 0001     
0057 000E 3FA0             DATA T1_WP, UNZIP_DATA, >0001   ; Task 1 TCB
     0010 1000     
     0012 0001     
0058               TCB_INIT_DATA_END
0059               
0060               TCB_INIT
0061 0014 0200  12         LI R0, TCB_INIT_DATA            ; Copy TCBs from ROM to RAM
     0016 0008     
0062 0018 0201  12         LI R1, TCBS
     001A 3FE0     
0063 001C 0202  12         LI R2, (TCB_INIT_DATA_END-TCB_INIT_DATA)/2
     001E 0006     
0064               TCB_INIT_COPY
0065 0020 CC70  42         MOV *R0+, *R1+
0066 0022 0602  10         DEC R2
0067 0024 16FD  10         JNE TCB_INIT_COPY
0068               
0069               INIT_STACKS
0070 0026 0201  12         LI R1, MUX0
     0028 F000     
0071 002A C801  30         MOV R1, @T0_WP + (1 * 2)
     002C 3F82     
0072 002E 0201  12         LI R1, T0_SP
     0030 3ED0     
0073 0032 C801  30         MOV R1, @T0_WP + (10 * 2)
     0034 3F94     
0074               
0075 0036 0201  12         LI R1, MUX1
     0038 F00A     
0076 003A C801  30         MOV R1, @T1_WP + (1 * 2)
     003C 3FA2     
0077 003E 0201  12         LI R1, T1_SP
     0040 3410     
0078 0042 C801  30         MOV R1, @T1_WP + (10 * 2)
     0044 3FB4     
0079                       ;B @UNZIP_DATA
0080               
0081                                                       ; Load and run Task 1
0082 0046 0201  12         LI R1, TCBS                     ; Set the first task as the "next" to run
     0048 3FE0     
0083 004A 1011  10         JMP ISR_TIMER_RESUME            ; Jump straight to resume it!
0084               
0085               ;*************************************************
0086               ;                       Scheduler
0087               ISR_TIMER
0088 004C 0300  14         LIMI 0                          ; INT OFF
     004E 0000     
0089 0050 04E0  26         CLR @TMRRST                     ; MMIO Write to clear timer interrupt
     0052 F0F0     
0090               
0091 0054 C020  26         MOV @TCUR, R0                   ;Load current TCB address to R0
     0056 3FEC     
0092 0058 C040  14         MOV R0, R1                      ;Copy to R1...
0093 005A 0221  14         AI R1, >6                       ;and increment to next TCB
     005C 0006     
0094               
0095                                                       ;Loop back around to the first task
0096 005E 0281  14         CI R1, TCBE                     ;If next task is NOT past the end of the TCB Table
     0060 3FEC     
0097 0062 1602  10         JNE ISR_TIMER_SWAP              ;THEN goto SWAP
0098 0064 0201  12         LI R1, TCBS                     ;ELSE set it to the first one
     0066 3FE0     
0099               ISR_TIMER_SWAP
0100               
0101               ISR_TIMER_SUSPEND                       ;Suspend task to TCB in R0
0102 0068 CC0D  30         MOV R13, *R0+                   ; Save context to TCB
0103 006A CC0E  30         MOV R14, *R0+
0104 006C CC0F  30         MOV R15, *R0+
0105               ISR_TIMER_RESUME                        ;Resume task from TCB in R1
0106 006E C801  30         MOV R1, @TCUR                   ; Save as current task
     0070 3FEC     
0107 0072 C371  26         MOV *R1+, R13                   ; Restore context from TCB
0108 0074 C3B1  26         MOV *R1+, R14
0109 0076 C3F1  26         MOV *R1+, R15
0110 0078 0380  14         RTWP
0111               
0112               
0113               ;*************************************************
0114               ;                       Decompress
0115               UNZIP                                   ;Uncompress
0116 007A 0200  12         LI R0, UNZIP_COMPRESSED_DATA    ;Input data in rom
     007C 0136     
0117 007E 0201  12         LI R1, UNZIP_DATA               ;output in ram
     0080 1000     
0118 0082 06A0  20         BL @DZX0                        ;Call
     0084 0088     
0119 0086 10C6  10         JMP TCB_INIT
0120               
0121                       COPY "../zx0/dzx0.a99"
     **** ****     > ../zx0/dzx0.a99
0001               ; -----------------------------------------------------------------------------
0002               ; ZX0 decoder for TMS9900
0003               ; Based on Z80 "Standard" version by Einar Saukas & Urusergi
0004               ; Ported for TMS9900 architecture
0005               ; -----------------------------------------------------------------------------
0006               ; Usage:
0007               ;   LI   R0,COMPRESSED_ADDR     ; Source address (compressed data in ROM)
0008               ;   LI   R1,DEST_ADDR           ; Destination address (RAM)
0009               ;   BL   @DZX0
0010               ;   ; On return: R1 points to byte after last decompressed byte
0011               ; -----------------------------------------------------------------------------
0012               ; Register usage:
0013               ;   R0:  Input Pointer
0014               ;   R1:  Output Pointer
0015               ;   R2:  Bit value (current byte being read bit-by-bit)
0016               ;   R3:  Bit mask (0x8000, 0x4000, ... 0x0100, then refill)
0017               ;   R4:  Backtrack
0018               ;   R5:  Last Byte
0019               ;   R6: last_offset
0020               ;   R7: length
0021               ;   R8: i
0022               ;   R9 Elias return
0023               ;   R12: 1 for inverted elias, 0 for normal
0024               ;   R15: Read bit return
0025               ; Scratch R15, R14, R13
0026               ; -----------------------------------------------------------------------------
0027               
0028                                                       ; Uses R13 as scratch
0029               DZX0
0030 0088 C34B  14         MOV R11, R13
0031 008A 0206  12         LI R6, >1                       ;last_offset = INITIAL_OFFSET = 1
     008C 0001     
0032 008E 0203  12         LI R3, >0080                    ;bit mask = 0
     0090 0080     
0033 0092 04C4  10         CLR R4                          ;backtrack = 0
0034 0094 04CC  10         CLR R12
0035               COPY_LITERALS:
0036 0096 06A0  20         BL @ELIAS
     0098 011C     
0037               LIT_LOOP:
0038 009A DC70  38         MOVB *R0+, *R1+                 ; *output_ptr++ = *input_ptr++
0039 009C 0609  10         DEC R9
0040 009E 16FD  10         JNE LIT_LOOP
0041               
0042 00A0 06A0  20         BL @READBIT                     ;if (read_bit())
     00A2 00F4     
0043 00A4 1607  10         JNE NEW_OFFSET                  ;       goto COPY_FROM_NEW_OFFSET;
0044               
0045                                                       ;Uses R15 as scratch
0046               LAST_OFFSET:
0047 00A6 06A0  20         BL @ELIAS
     00A8 011C     
0048               
0049 00AA 06A0  20         BL @WRITE_OFFSET
     00AC 00E8     
0050               
0051 00AE 06A0  20         BL @READBIT                     ;if (!read_bit())
     00B0 00F4     
0052 00B2 13F1  10         JEQ COPY_LITERALS               ;       goto COPY_LITERALS;
0053               
0054                                                       ;Uses R15 as scratch
0055               NEW_OFFSET
0056 00B4 058C  10         INC R12                         ;Inverted!
0057 00B6 06A0  20         BL @ELIAS
     00B8 011C     
0058 00BA 04CC  10         CLR R12
0059               
0060 00BC 0289  14         CI R9, >0100                    ; Done condition
     00BE 0100     
0061 00C0 1312  10         JEQ DZX_DONE
0062               
0063 00C2 C189  14         MOV R9, R6                      ;last_offset = read_interlaced_elias_gamma(1);
0064 00C4 D170  24         MOVB *R0+, R5                   ;last_byte = *input_ptr++;
0065               
0066                                                       ;last_offset = last_offset * 128 - (last_byte >> 1);
0067 00C6 0A76  26         SLA R6, 7                       ;last_offset = last_offset * 128
0068 00C8 C3C5  14         MOV R5, R15                     ; R15 = last_byte
0069 00CA 06CF  10         SWPB R15
0070 00CC 091F  14         SRL R15, 1                      ; R15 = last_byte >> 1
0071 00CE 618F  14         S R15, R6                       ;last_offset = last_offset * 128 - (last_byte >> 1);
0072               
0073 00D0 0204  12         LI R4, 1                        ;backtrack = 1
     00D2 0001     
0074               
0075 00D4 06A0  20         BL @ELIAS
     00D6 011C     
0076 00D8 0589  10         INC R9                          ; R9 length = read_interlaced_elias_gamma(0) + 1;
0077 00DA 06A0  20         BL @WRITE_OFFSET
     00DC 00E8     
0078               
0079 00DE 06A0  20         BL @READBIT
     00E0 00F4     
0080 00E2 16E8  10         JNE NEW_OFFSET
0081 00E4 10D8  10         JMP COPY_LITERALS
0082               DZX_DONE
0083 00E6 045D  16         B *R13
0084               
0085                                                       ;Uses R15 as Scratch & Return Value
0086               WRITE_OFFSET                            ;Leaf function, no need to store R11
0087 00E8 C3C1  14         MOV R1, R15                     ; R6 = current output_ptr
0088 00EA 63C6  14         S R6, R15                       ; R6 = output_ptr - last_offset
0089               WRITE_OFFSET_LOOP:
0090 00EC DC7F  38         MOVB *R15+, *R1+                ; *output_ptr++ = *(output_ptr - offset)++
0091 00EE 0609  10         DEC R9
0092 00F0 16FD  10         JNE WRITE_OFFSET_LOOP
0093 00F2 045B  16         B *R11
0094               
0095               
0096                                                       ;Uses R15 as Scratch & Return Value
0097               READBIT                                 ;Leaf function, no need to store R11
0098 00F4 C104  14         MOV R4, R4
0099 00F6 1305  10         JEQ READBIT_NO_BACKTRACK
0100 00F8 04C4  10         CLR R4
0101 00FA C3C5  14         MOV R5, R15
0102 00FC 024F  14         ANDI R15, >0100
     00FE 0100     
0103 0100 045B  16         B *R11
0104               READBIT_NO_BACKTRACK
0105 0102 0283  14         CI R3, >0080                    ;Has the bit fallen off the high bit?
     0104 0080     
0106 0106 1603  10         JNE READBIT_HAVE_BYTE           ; if not there are still bits left to read
0107 0108 D0B0  24         MOVB *R0+, R2                   ;read the new byte
0108 010A 0203  12         LI R3, >8000                    ;reset the bit mask
     010C 8000     
0109               READBIT_HAVE_BYTE
0110 010E 04CF  10         CLR R15                         ;Prepare to return zero
0111 0110 2083  14         COC R3, R2                      ;Check byte vs mask
0112 0112 1601  10         JNE READBIT_ZERO                ;Jump to zero return
0113 0114 058F  10         INC R15                         ;Change return to one
0114               READBIT_ZERO
0115 0116 0913  14         SRL R3, 1                       ;Shift mask
0116 0118 C3CF  14         MOV R15, R15                    ;Reload return value so callers can just use EQ status bit
0117 011A 045B  16         B *R11
0118               
0119                                                       ;Uses R14 as scratch
0120                                                       ;Retrns in R9
0121               ELIAS
0122 011C C38B  14         MOV R11, R14                    ; Save return address
0123 011E 0209  12         LI R9, 1                        ; value = 1
     0120 0001     
0124               ELIAS_LOOP
0125 0122 06A0  20         BL @READBIT                     ; Read data bit
     0124 00F4     
0126 0126 1606  10         JNE ELIAS_DONE                  ; If bit=1, done
0127                                                       ; Data bit was 0, continue
0128 0128 0A19  14         SLA R9, 1                       ; value <<= 1
0129 012A 06A0  20         BL @READBIT                     ; Read value bit
     012C 00F4     
0130 012E 2BCC  14         XOR R12, R15                    ; possibly invert the one bit
0131 0130 A24F  14         A R15, R9                       ; R15 is 1 or zero, add it
0132 0132 10F7  10         JMP ELIAS_LOOP
0133               ELIAS_DONE
0134 0134 045E  16         B *R14
                   < boot.a99
