0130                       COPY "../zx0/dzx0.a99"
     **** ****     > ../zx0/dzx0.a99
0001               ; -----------------------------------------------------------------------------
0002               ; ZX0 decoder for TMS9900
0003               ; Based on Z80 "Standard" version by Einar Saukas & Urusergi
0004               ; Ported for TMS9900 architecture
0005               ; -----------------------------------------------------------------------------
0006               ; Usage:
0007               ;   LI   R0,COMPRESSED_ADDR     ; Source address (compressed data in ROM)
0008               ;   LI   R1,DEST_ADDR           ; Destination address (RAM)
0009               ;   BL   @DZX0
0010               ;   ; On return: R1 points to byte after last decompressed byte
0011               ; -----------------------------------------------------------------------------
0012               ; Register usage:
0013               ;   R0:  Input Pointer
0014               ;   R1:  Output Pointer
0015               ;   R2:  Bit value (current byte being read bit-by-bit)
0016               ;   R3:  Bit mask (0x8000, 0x4000, ... 0x0100, then refill)
0017               ;   R4:  Backtrack
0018               ;   R5:  Last Byte
0019               ;   R6: last_offset
0020               ;   R7: length
0021               ;   R8: i
0022               ;   R9 Elias return
0023               ;   R12: 1 for inverted elias, 0 for normal
0024               ;   R15: Read bit return
0025               ; Scratch R15, R14, R13
0026               ; -----------------------------------------------------------------------------
0027               
0028                                                       ; Uses R13 as scratch
0029               DZX0
0030 00BA C34B  14         MOV R11, R13
0031 00BC 0206  12         LI R6, >1                       ;last_offset = INITIAL_OFFSET = 1
     00BE 0001     
0032 00C0 0203  12         LI R3, >0080                    ;bit mask = 0
     00C2 0080     
0033 00C4 04C4  10         CLR R4                          ;backtrack = 0
0034 00C6 04CC  10         CLR R12
0035               COPY_LITERALS:
0036 00C8 06A0  20         BL @ELIAS
     00CA 014E     
0037               LIT_LOOP:
0038 00CC DC70  38         MOVB *R0+, *R1+                 ; *output_ptr++ = *input_ptr++
0039 00CE 0609  10         DEC R9
0040 00D0 16FD  10         JNE LIT_LOOP
0041               
0042 00D2 06A0  20         BL @READBIT                     ;if (read_bit())
     00D4 0126     
0043 00D6 1607  10         JNE NEW_OFFSET                  ;       goto COPY_FROM_NEW_OFFSET;
0044               
0045                                                       ;Uses R15 as scratch
0046               LAST_OFFSET:
0047 00D8 06A0  20         BL @ELIAS
     00DA 014E     
0048               
0049 00DC 06A0  20         BL @WRITE_OFFSET
     00DE 011A     
0050               
0051 00E0 06A0  20         BL @READBIT                     ;if (!read_bit())
     00E2 0126     
0052 00E4 13F1  10         JEQ COPY_LITERALS               ;       goto COPY_LITERALS;
0053               
0054                                                       ;Uses R15 as scratch
0055               NEW_OFFSET
0056 00E6 058C  10         INC R12                         ;Inverted!
0057 00E8 06A0  20         BL @ELIAS
     00EA 014E     
0058 00EC 04CC  10         CLR R12
0059               
0060 00EE 0289  14         CI R9, >0100                    ; Done condition
     00F0 0100     
0061 00F2 1312  10         JEQ DZX_DONE
0062               
0063 00F4 C189  14         MOV R9, R6                      ;last_offset = read_interlaced_elias_gamma(1);
0064 00F6 D170  24         MOVB *R0+, R5                   ;last_byte = *input_ptr++;
0065               
0066                                                       ;last_offset = last_offset * 128 - (last_byte >> 1);
0067 00F8 0A76  26         SLA R6, 7                       ;last_offset = last_offset * 128
0068 00FA C3C5  14         MOV R5, R15                     ; R15 = last_byte
0069 00FC 06CF  10         SWPB R15
0070 00FE 091F  14         SRL R15, 1                      ; R15 = last_byte >> 1
0071 0100 618F  14         S R15, R6                       ;last_offset = last_offset * 128 - (last_byte >> 1);
0072               
0073 0102 0204  12         LI R4, 1                        ;backtrack = 1
     0104 0001     
0074               
0075 0106 06A0  20         BL @ELIAS
     0108 014E     
0076 010A 0589  10         INC R9                          ; R9 length = read_interlaced_elias_gamma(0) + 1;
0077 010C 06A0  20         BL @WRITE_OFFSET
     010E 011A     
0078               
0079 0110 06A0  20         BL @READBIT
     0112 0126     
0080 0114 16E8  10         JNE NEW_OFFSET
0081 0116 10D8  10         JMP COPY_LITERALS
0082               DZX_DONE
0083 0118 045D  16         B *R13
0084               
0085                                                       ;Uses R15 as Scratch & Return Value
0086               WRITE_OFFSET                            ;Leaf function, no need to store R11
0087 011A C3C1  14         MOV R1, R15                     ; R6 = current output_ptr
0088 011C 63C6  14         S R6, R15                       ; R6 = output_ptr - last_offset
0089               WRITE_OFFSET_LOOP:
0090 011E DC7F  38         MOVB *R15+, *R1+                ; *output_ptr++ = *(output_ptr - offset)++
0091 0120 0609  10         DEC R9
0092 0122 16FD  10         JNE WRITE_OFFSET_LOOP
0093 0124 045B  16         B *R11
0094               
0095               
0096                                                       ;Uses R15 as Scratch & Return Value
0097               READBIT                                 ;Leaf function, no need to store R11
0098 0126 C104  14         MOV R4, R4
0099 0128 1305  10         JEQ READBIT_NO_BACKTRACK
0100 012A 04C4  10         CLR R4
0101 012C C3C5  14         MOV R5, R15
0102 012E 024F  14         ANDI R15, >0100
     0130 0100     
0103 0132 045B  16         B *R11
0104               READBIT_NO_BACKTRACK
0105 0134 0283  14         CI R3, >0080                    ;Has the bit fallen off the high bit?
     0136 0080     
0106 0138 1603  10         JNE READBIT_HAVE_BYTE           ; if not there are still bits left to read
0107 013A D0B0  24         MOVB *R0+, R2                   ;read the new byte
0108 013C 0203  12         LI R3, >8000                    ;reset the bit mask
     013E 8000     
0109               READBIT_HAVE_BYTE
0110 0140 04CF  10         CLR R15                         ;Prepare to return zero
0111 0142 2083  14         COC R3, R2                      ;Check byte vs mask
0112 0144 1601  10         JNE READBIT_ZERO                ;Jump to zero return
0113 0146 058F  10         INC R15                         ;Change return to one
0114               READBIT_ZERO
0115 0148 0913  14         SRL R3, 1                       ;Shift mask
0116 014A C3CF  14         MOV R15, R15                    ;Reload return value so callers can just use EQ status bit
0117 014C 045B  16         B *R11
0118               
0119                                                       ;Uses R14 as scratch
0120                                                       ;Retrns in R9
0121               ELIAS
0122 014E C38B  14         MOV R11, R14                    ; Save return address
0123 0150 0209  12         LI R9, 1                        ; value = 1
     0152 0001     
0124               ELIAS_LOOP
0125 0154 06A0  20         BL @READBIT                     ; Read data bit
     0156 0126     
0126 0158 1606  10         JNE ELIAS_DONE                  ; If bit=1, done
0127                                                       ; Data bit was 0, continue
0128 015A 0A19  14         SLA R9, 1                       ; value <<= 1
0129 015C 06A0  20         BL @READBIT                     ; Read value bit
     015E 0126     
0130 0160 2BCC  14         XOR R12, R15                    ; possibly invert the one bit
0131 0162 A24F  14         A R15, R9                       ; R15 is 1 or zero, add it
0132 0164 10F7  10         JMP ELIAS_LOOP
0133               ELIAS_DONE
0134 0166 045E  16         B *R14
                   < boot.a99
