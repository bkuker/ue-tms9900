0001                       COPY "../mux.a99"
     **** ****     > ../mux.a99
0001      F000     MUX0    EQU >F000
0002      F000     M0STAT  EQU >F000                       ;  Read status: bit 0 = Transmit Busy, bit 1 = Data Received
0003      F002     M0RX    EQU >F002                       ;  Read byte received in 8 LSB
0004      F003     M0RXB   EQU >F003                       ;  Read byte received
0005      F004     M0TX    EQU >F004                       ;  Write byte to send in 8 LSB
0006      F005     M0TXB   EQU >F005                       ;  Write byte to send
0007      F006     M0RST   EQU >F006                       ;  Write to reset interrupt and Data Received status
0008      0002     M0IRQ   EQU >2                          ;  IRQ for Mux0
0009               
0010                                                       ; Mux1 constants
0011      F008     MUX1    EQU >F008
0012      F008     M1STAT  EQU >F008
0013      F00A     M1RX    EQU >F00A
0014      F00B     M1RXB   EQU >F00B
0015      F00C     M1TX    EQU >F00C
0016      F00D     M1TXB   EQU >F00D
0017      F00E     M1RST   EQU >F00E
0018      0003     M1IRQ   EQU >3
                   < boot.a99
0002                       COPY "../addrs.a99"
     **** ****     > ../addrs.a99
0001      0000     VECTORS EQU >0000
0002      0040     TRAPS   EQU >0040
0003      0080     GENERAL EQU >0080
0004      1000     RAM_START EQU >1000
0005      3FFE     RAM_END EQU >3FFE
                   < boot.a99
0003               
0004      0004     TMRIRQ  EQU >4                          ; Timer IRQ
0005      F010     TMRRST  EQU >F010
0006               
0007               ;*************************************************
0008               ;                       Stacks
0009      3ED0     T0_SP   EQU >4000 - >130
0010      3520     T1_SP   EQU >3520
0011               
0012                       DORG >4000 - 128
0013               ;*************************************************
0014               ;                       Task Workspaces
0015 3F80          T0_WP   BSS 32
0016 3FA0          T1_WP   BSS 32
0017               
0018               ;*************************************************
0019               ;                       Scheduler RAM
0020 3FC0          OSWP    BSS 32                          ; Set aside 32 bytes/16 words for primary workspace
0021               
0022               TCBS                                    ; Start of TCB Table
0023 3FE0                  BSS 6                           ; WP,PC,ST
0024 3FE6                  BSS 6
0025               TCBE                                    ; End of TCB Table
0026               
0027 3FEC          TCUR    BSS 2                           ; Pointer to TCB for current task
0028               
0029 3FEE          M0STATC BSS 2
0030 3FF0          M1STATC BSS 2
0031               
0032               ;*************************************************
0033               ;                       ROM Start
0034                       AORG >0000                      ; Reset Vector...
0035 0000 3FC0             DATA OSWP                       ;       OS workspace addr
0036 0002 00AC             DATA UNZIP                      ;       Init code
0037               
0038               M0IRQV  AORG M0IRQ * 4
0039 0008 3FC0             DATA OSWP
0040 000A 0014             DATA ISR_MUX_0
0041               
0042               M1IRQV  AORG M1IRQ * 4
0043 000C 3FC0             DATA OSWP
0044 000E 0014             DATA ISR_MUX_1
0045               
0046               TIMERV  AORG TMRIRQ * 4                 ; Timer Vector
0047 0010 3FC0             DATA OSWP                       ;       OS Workspace
0048 0012 007E             DATA ISR_TIMER                  ;       Scheduler code
0049               
0050               ISR_MUX_0
0051               ISR_MUX_1
0052 0014 C820  42         MOV @M0STAT, @M0STATC
     0016 F000     
     0018 3FEE     
0053 001A C820  42         MOV @M1STAT, @M1STATC
     001C F008     
     001E 3FF0     
0054 0020 04E0  26         CLR @M0RST
     0022 F006     
0055 0024 04E0  26         CLR @M1RST
     0026 F00E     
0056 0028 0380  14         RTWP
0057               
0058               ;*************************************************
0059               ;                       TCB Initialization
0060               TCB_INIT_DATA                           ; Initial Ram Values
0061 002A 3F80             DATA T0_WP, UNZIP_DATA, >0004   ; Task 0 TCB //TODO FIX INT MASK!!!
     002C 1000     
     002E 0004     
0062 0030 3FA0             DATA T1_WP, UNZIP_DATA, >0004   ; Task 1 TCB
     0032 1000     
     0034 0004     
0063               TCB_INIT_DATA_END
0064               
0065               TCB_INIT
0066 0036 0200  12         LI R0, TCB_INIT_DATA            ; Copy TCBs from ROM to RAM
     0038 002A     
0067 003A 0201  12         LI R1, TCBS
     003C 3FE0     
0068 003E 0202  12         LI R2, (TCB_INIT_DATA_END-TCB_INIT_DATA)/2
     0040 0006     
0069               TCB_INIT_COPY
0070 0042 CC70  42         MOV *R0+, *R1+
0071 0044 0602  10         DEC R2
0072 0046 16FD  10         JNE TCB_INIT_COPY
0073               
0074               INIT_STACKS
0075 0048 0201  12         LI R1, MUX0
     004A F000     
0076 004C C801  30         MOV R1, @T0_WP + (1 * 2)
     004E 3F82     
0077 0050 0201  12         LI R1, M0STATC
     0052 3FEE     
0078 0054 C801  30         MOV R1, @T0_WP + (2 * 2)
     0056 3F84     
0079 0058 0201  12         LI R1, T0_SP
     005A 3ED0     
0080 005C C801  30         MOV R1, @T0_WP + (10 * 2)
     005E 3F94     
0081               
0082 0060 0201  12         LI R1, MUX1
     0062 F008     
0083 0064 C801  30         MOV R1, @T1_WP + (1 * 2)
     0066 3FA2     
0084 0068 0201  12         LI R1, M1STATC
     006A 3FF0     
0085 006C C801  30         MOV R1, @T1_WP + (2 * 2)
     006E 3FA4     
0086 0070 0201  12         LI R1, T1_SP
     0072 3520     
0087 0074 C801  30         MOV R1, @T1_WP + (10 * 2)
     0076 3FB4     
0088                       ;B @UNZIP_DATA
0089               
0090                                                       ; Load and run Task 1
0091 0078 0201  12         LI R1, TCBS                     ; Set the first task as the "next" to run
     007A 3FE0     
0092 007C 1011  10         JMP ISR_TIMER_RESUME            ; Jump straight to resume it!
0093               
0094               ;*************************************************
0095               ;                       Scheduler
0096               ISR_TIMER
0097 007E 0300  14         LIMI 0                          ; INT OFF
     0080 0000     
0098 0082 04E0  26         CLR @TMRRST                     ; MMIO Write to clear timer interrupt
     0084 F010     
0099               
0100 0086 C020  26         MOV @TCUR, R0                   ;Load current TCB address to R0
     0088 3FEC     
0101 008A C040  14         MOV R0, R1                      ;Copy to R1...
0102 008C 0221  14         AI R1, >6                       ;and increment to next TCB
     008E 0006     
0103               
0104                                                       ;Loop back around to the first task
0105 0090 0281  14         CI R1, TCBE                     ;If next task is NOT past the end of the TCB Table
     0092 3FEC     
0106 0094 1602  10         JNE ISR_TIMER_SWAP              ;THEN goto SWAP
0107 0096 0201  12         LI R1, TCBS                     ;ELSE set it to the first one
     0098 3FE0     
0108               ISR_TIMER_SWAP
0109               
0110               ISR_TIMER_SUSPEND                       ;Suspend task to TCB in R0
0111 009A CC0D  30         MOV R13, *R0+                   ; Save context to TCB
0112 009C CC0E  30         MOV R14, *R0+
0113 009E CC0F  30         MOV R15, *R0+
0114               ISR_TIMER_RESUME                        ;Resume task from TCB in R1
0115 00A0 C801  30         MOV R1, @TCUR                   ; Save as current task
     00A2 3FEC     
0116 00A4 C371  26         MOV *R1+, R13                   ; Restore context from TCB
0117 00A6 C3B1  26         MOV *R1+, R14
0118 00A8 C3F1  26         MOV *R1+, R15
0119 00AA 0380  14         RTWP
0120               
0121               
0122               ;*************************************************
0123               ;                       Decompress
0124               UNZIP                                   ;Uncompress
0125 00AC 0200  12         LI R0, UNZIP_COMPRESSED_DATA    ;Input data in rom
     00AE 0168     
0126 00B0 0201  12         LI R1, UNZIP_DATA               ;output in ram
     00B2 1000     
0127 00B4 06A0  20         BL @DZX0                        ;Call
     00B6 00BA     
0128 00B8 10BE  10         JMP TCB_INIT
