0001                       COPY "../mux.a99"
     **** ****     > ../mux.a99
0001      F000     MUX0    EQU >F000
0002      F000     M0STAT  EQU >F000                       ;  Read status: bit 0 = Transmit Busy, bit 1 = Data Received
0003      F002     M0RX    EQU >F002                       ;  Read byte received in 8 LSB
0004      F003     M0RXB   EQU >F003                       ;  Read byte received
0005      F004     M0TX    EQU >F004                       ;  Write byte to send in 8 LSB
0006      F005     M0TXB   EQU >F005                       ;  Write byte to send
0007      F006     M0RST   EQU >F006                       ;  Write to reset interrupt and Data Received status
0008      0002     M0IRQ   EQU >2                          ;  IRQ for Mux0
0009               
0010                                                       ; Mux1 constants
0011      F008     MUX1    EQU >F008
0012      F008     M1STAT  EQU >F008
0013      F00A     M1RX    EQU >F00A
0014      F00B     M1RXB   EQU >F00B
0015      F00C     M1TX    EQU >F00C
0016      F00D     M1TXB   EQU >F00D
0017      F00E     M1RST   EQU >F00E
0018      0003     M1IRQ   EQU >3
                   < boot.a99
0002                       COPY "../addrs.a99"
     **** ****     > ../addrs.a99
0001      0000     VECTORS EQU >0000
0002      0040     TRAPS   EQU >0040
0003      0080     GENERAL EQU >0080
0004      1000     RAM_START EQU >1000
0005      3FFE     RAM_END EQU >3FFE
                   < boot.a99
0003               
0004      0004     TMRIRQ  EQU >4                          ; Timer IRQ
0005      F010     TMRRST  EQU >F010
0006               
0007               ;*************************************************
0008               ;                       Stacks
0009      3ED0     T0_SP   EQU >4000 - >130
0010      3500     T1_SP   EQU >3500
0011               
0012                       DORG >4000 - 128
0013               ;*************************************************
0014               ;                       Task Workspaces
0015 3F80          T0_WP   BSS 32
0016 3FA0          T1_WP   BSS 32
0017               
0018               ;*************************************************
0019               ;                       Scheduler RAM
0020 3FC0          OSWP    BSS 32                          ; Set aside 32 bytes/16 words for primary workspace
0021               
0022               TCBS                                    ; Start of TCB Table
0023 3FE0                  BSS 6                           ; WP,PC,ST
0024 3FE6                  BSS 6
0025               TCBE                                    ; End of TCB Table
0026               
0027 3FEC          TCUR    BSS 2                           ; Pointer to TCB for current task
0028               
0029 3FEE          M0STATC BSS 2
0030 3FF0          M1STATC BSS 2
0031               
0032               ;*************************************************
0033               ;                       ROM Start
0034                       AORG >0000                      ; Reset Vector...
0035 0000 3FC0             DATA OSWP                       ;       OS workspace addr
0036 0002 00B8             DATA UNZIP                      ;       Init code
0037               
0038               M0IRQV  AORG M0IRQ * 4
0039 0008 3FC0             DATA OSWP
0040 000A 0014             DATA ISR_MUX_0
0041               
0042               M1IRQV  AORG M1IRQ * 4
0043 000C 3FC0             DATA OSWP
0044 000E 0014             DATA ISR_MUX_1
0045               
0046               TIMERV  AORG TMRIRQ * 4                 ; Timer Vector
0047 0010 3FC0             DATA OSWP                       ;       OS Workspace
0048 0012 008A             DATA ISR_TIMER                  ;       Scheduler code
0049               
0050               ISR_MUX_0
0051               ISR_MUX_1
0052 0014 C820  42         MOV @M0STAT, @M0STATC
     0016 F000     
     0018 3FEE     
0053 001A C820  42         MOV @M1STAT, @M1STATC
     001C F008     
     001E 3FF0     
0054 0020 04E0  26         CLR @M0RST
     0022 F006     
0055 0024 04E0  26         CLR @M1RST
     0026 F00E     
0056 0028 0380  14         RTWP
0057               
0058               ;*************************************************
0059               ;                       TCB Initialization
0060               TCB_INIT_DATA                           ; Initial Ram Values
0061 002A 3F80             DATA T0_WP, UNZIP_DATA, >0004   ; Task 0 TCB //TODO FIX INT MASK!!!
     002C 1000     
     002E 0004     
0062 0030 3FA0             DATA T1_WP, UNZIP_DATA, >0004   ; Task 1 TCB
     0032 1000     
     0034 0004     
0063               TCB_INIT_DATA_END
0064               
0065               TCB_INIT
0066 0036 0200  12         LI R0, TCB_INIT_DATA            ; Copy TCBs from ROM to RAM
     0038 002A     
0067 003A 0201  12         LI R1, TCBS
     003C 3FE0     
0068 003E 0202  12         LI R2, (TCB_INIT_DATA_END-TCB_INIT_DATA)/2
     0040 0006     
0069               TCB_INIT_COPY
0070 0042 CC70  42         MOV *R0+, *R1+
0071 0044 0602  10         DEC R2
0072 0046 16FD  10         JNE TCB_INIT_COPY
0073               
0074               INIT_STACKS
0075 0048 0201  12         LI R1, >0002
     004A 0002     
0076 004C C801  30         MOV R1, @M0STATC
     004E 3FEE     
0077 0050 C801  30         MOV R1, @M1STATC
     0052 3FF0     
0078               
0079 0054 0201  12         LI R1, MUX0
     0056 F000     
0080 0058 C801  30         MOV R1, @T0_WP + (1 * 2)
     005A 3F82     
0081 005C 0201  12         LI R1, M0STATC
     005E 3FEE     
0082 0060 C801  30         MOV R1, @T0_WP + (2 * 2)
     0062 3F84     
0083 0064 0201  12         LI R1, T0_SP
     0066 3ED0     
0084 0068 C801  30         MOV R1, @T0_WP + (10 * 2)
     006A 3F94     
0085               
0086 006C 0201  12         LI R1, MUX1
     006E F008     
0087 0070 C801  30         MOV R1, @T1_WP + (1 * 2)
     0072 3FA2     
0088 0074 0201  12         LI R1, M1STATC
     0076 3FF0     
0089 0078 C801  30         MOV R1, @T1_WP + (2 * 2)
     007A 3FA4     
0090 007C 0201  12         LI R1, T1_SP
     007E 3500     
0091 0080 C801  30         MOV R1, @T1_WP + (10 * 2)
     0082 3FB4     
0092                       ;B @UNZIP_DATA
0093               
0094                                                       ; Load and run Task 1
0095 0084 0201  12         LI R1, TCBS                     ; Set the first task as the "next" to run
     0086 3FE0     
0096 0088 1011  10         JMP ISR_TIMER_RESUME            ; Jump straight to resume it!
0097               
0098               ;*************************************************
0099               ;                       Scheduler
0100               ISR_TIMER
0101 008A 0300  14         LIMI 0                          ; INT OFF
     008C 0000     
0102 008E 04E0  26         CLR @TMRRST                     ; MMIO Write to clear timer interrupt
     0090 F010     
0103               
0104 0092 C020  26         MOV @TCUR, R0                   ;Load current TCB address to R0
     0094 3FEC     
0105 0096 C040  14         MOV R0, R1                      ;Copy to R1...
0106 0098 0221  14         AI R1, >6                       ;and increment to next TCB
     009A 0006     
0107               
0108                                                       ;Loop back around to the first task
0109 009C 0281  14         CI R1, TCBE                     ;If next task is NOT past the end of the TCB Table
     009E 3FEC     
0110 00A0 1602  10         JNE ISR_TIMER_SWAP              ;THEN goto SWAP
0111 00A2 0201  12         LI R1, TCBS                     ;ELSE set it to the first one
     00A4 3FE0     
0112               ISR_TIMER_SWAP
0113               
0114               ISR_TIMER_SUSPEND                       ;Suspend task to TCB in R0
0115 00A6 CC0D  30         MOV R13, *R0+                   ; Save context to TCB
0116 00A8 CC0E  30         MOV R14, *R0+
0117 00AA CC0F  30         MOV R15, *R0+
0118               ISR_TIMER_RESUME                        ;Resume task from TCB in R1
0119 00AC C801  30         MOV R1, @TCUR                   ; Save as current task
     00AE 3FEC     
0120 00B0 C371  26         MOV *R1+, R13                   ; Restore context from TCB
0121 00B2 C3B1  26         MOV *R1+, R14
0122 00B4 C3F1  26         MOV *R1+, R15
0123 00B6 0380  14         RTWP
0124               
0125               
0126               ;*************************************************
0127               ;                       Decompress
0128               UNZIP                                   ;Uncompress
0129 00B8 0200  12         LI R0, UNZIP_COMPRESSED_DATA    ;Input data in rom
     00BA 0174     
0130 00BC 0201  12         LI R1, UNZIP_DATA               ;output in ram
     00BE 1000     
0131 00C0 06A0  20         BL @DZX0                        ;Call
     00C2 00C6     
0132 00C4 10B8  10         JMP TCB_INIT
0133               
0134                       COPY "../zx0/dzx0.a99"
     **** ****     > ../zx0/dzx0.a99
0001               ; -----------------------------------------------------------------------------
0002               ; ZX0 decoder for TMS9900
0003               ; Based on Z80 "Standard" version by Einar Saukas & Urusergi
0004               ; Ported for TMS9900 architecture
0005               ; -----------------------------------------------------------------------------
0006               ; Usage:
0007               ;   LI   R0,COMPRESSED_ADDR     ; Source address (compressed data in ROM)
0008               ;   LI   R1,DEST_ADDR           ; Destination address (RAM)
0009               ;   BL   @DZX0
0010               ;   ; On return: R1 points to byte after last decompressed byte
0011               ; -----------------------------------------------------------------------------
0012               ; Register usage:
0013               ;   R0:  Input Pointer
0014               ;   R1:  Output Pointer
0015               ;   R2:  Bit value (current byte being read bit-by-bit)
0016               ;   R3:  Bit mask (0x8000, 0x4000, ... 0x0100, then refill)
0017               ;   R4:  Backtrack
0018               ;   R5:  Last Byte
0019               ;   R6: last_offset
0020               ;   R7: length
0021               ;   R8: i
0022               ;   R9 Elias return
0023               ;   R12: 1 for inverted elias, 0 for normal
0024               ;   R15: Read bit return
0025               ; Scratch R15, R14, R13
0026               ; -----------------------------------------------------------------------------
0027               
0028                                                       ; Uses R13 as scratch
0029               DZX0
0030 00C6 C34B  14         MOV R11, R13
0031 00C8 0206  12         LI R6, >1                       ;last_offset = INITIAL_OFFSET = 1
     00CA 0001     
0032 00CC 0203  12         LI R3, >0080                    ;bit mask = 0
     00CE 0080     
0033 00D0 04C4  10         CLR R4                          ;backtrack = 0
0034 00D2 04CC  10         CLR R12
0035               COPY_LITERALS:
0036 00D4 06A0  20         BL @ELIAS
     00D6 015A     
0037               LIT_LOOP:
0038 00D8 DC70  38         MOVB *R0+, *R1+                 ; *output_ptr++ = *input_ptr++
0039 00DA 0609  10         DEC R9
0040 00DC 16FD  10         JNE LIT_LOOP
0041               
0042 00DE 06A0  20         BL @READBIT                     ;if (read_bit())
     00E0 0132     
0043 00E2 1607  10         JNE NEW_OFFSET                  ;       goto COPY_FROM_NEW_OFFSET;
0044               
0045                                                       ;Uses R15 as scratch
0046               LAST_OFFSET:
0047 00E4 06A0  20         BL @ELIAS
     00E6 015A     
0048               
0049 00E8 06A0  20         BL @WRITE_OFFSET
     00EA 0126     
0050               
0051 00EC 06A0  20         BL @READBIT                     ;if (!read_bit())
     00EE 0132     
0052 00F0 13F1  10         JEQ COPY_LITERALS               ;       goto COPY_LITERALS;
0053               
0054                                                       ;Uses R15 as scratch
0055               NEW_OFFSET
0056 00F2 058C  10         INC R12                         ;Inverted!
0057 00F4 06A0  20         BL @ELIAS
     00F6 015A     
0058 00F8 04CC  10         CLR R12
0059               
0060 00FA 0289  14         CI R9, >0100                    ; Done condition
     00FC 0100     
0061 00FE 1312  10         JEQ DZX_DONE
0062               
0063 0100 C189  14         MOV R9, R6                      ;last_offset = read_interlaced_elias_gamma(1);
0064 0102 D170  24         MOVB *R0+, R5                   ;last_byte = *input_ptr++;
0065               
0066                                                       ;last_offset = last_offset * 128 - (last_byte >> 1);
0067 0104 0A76  26         SLA R6, 7                       ;last_offset = last_offset * 128
0068 0106 C3C5  14         MOV R5, R15                     ; R15 = last_byte
0069 0108 06CF  10         SWPB R15
0070 010A 091F  14         SRL R15, 1                      ; R15 = last_byte >> 1
0071 010C 618F  14         S R15, R6                       ;last_offset = last_offset * 128 - (last_byte >> 1);
0072               
0073 010E 0204  12         LI R4, 1                        ;backtrack = 1
     0110 0001     
0074               
0075 0112 06A0  20         BL @ELIAS
     0114 015A     
0076 0116 0589  10         INC R9                          ; R9 length = read_interlaced_elias_gamma(0) + 1;
0077 0118 06A0  20         BL @WRITE_OFFSET
     011A 0126     
0078               
0079 011C 06A0  20         BL @READBIT
     011E 0132     
0080 0120 16E8  10         JNE NEW_OFFSET
0081 0122 10D8  10         JMP COPY_LITERALS
0082               DZX_DONE
0083 0124 045D  16         B *R13
0084               
0085                                                       ;Uses R15 as Scratch & Return Value
0086               WRITE_OFFSET                            ;Leaf function, no need to store R11
0087 0126 C3C1  14         MOV R1, R15                     ; R6 = current output_ptr
0088 0128 63C6  14         S R6, R15                       ; R6 = output_ptr - last_offset
0089               WRITE_OFFSET_LOOP:
0090 012A DC7F  38         MOVB *R15+, *R1+                ; *output_ptr++ = *(output_ptr - offset)++
0091 012C 0609  10         DEC R9
0092 012E 16FD  10         JNE WRITE_OFFSET_LOOP
0093 0130 045B  16         B *R11
0094               
0095               
0096                                                       ;Uses R15 as Scratch & Return Value
0097               READBIT                                 ;Leaf function, no need to store R11
0098 0132 C104  14         MOV R4, R4
0099 0134 1305  10         JEQ READBIT_NO_BACKTRACK
0100 0136 04C4  10         CLR R4
0101 0138 C3C5  14         MOV R5, R15
0102 013A 024F  14         ANDI R15, >0100
     013C 0100     
0103 013E 045B  16         B *R11
0104               READBIT_NO_BACKTRACK
0105 0140 0283  14         CI R3, >0080                    ;Has the bit fallen off the high bit?
     0142 0080     
0106 0144 1603  10         JNE READBIT_HAVE_BYTE           ; if not there are still bits left to read
0107 0146 D0B0  24         MOVB *R0+, R2                   ;read the new byte
0108 0148 0203  12         LI R3, >8000                    ;reset the bit mask
     014A 8000     
0109               READBIT_HAVE_BYTE
0110 014C 04CF  10         CLR R15                         ;Prepare to return zero
0111 014E 2083  14         COC R3, R2                      ;Check byte vs mask
0112 0150 1601  10         JNE READBIT_ZERO                ;Jump to zero return
0113 0152 058F  10         INC R15                         ;Change return to one
0114               READBIT_ZERO
0115 0154 0913  14         SRL R3, 1                       ;Shift mask
0116 0156 C3CF  14         MOV R15, R15                    ;Reload return value so callers can just use EQ status bit
0117 0158 045B  16         B *R11
0118               
0119                                                       ;Uses R14 as scratch
0120                                                       ;Retrns in R9
0121               ELIAS
0122 015A C38B  14         MOV R11, R14                    ; Save return address
0123 015C 0209  12         LI R9, 1                        ; value = 1
     015E 0001     
0124               ELIAS_LOOP
0125 0160 06A0  20         BL @READBIT                     ; Read data bit
     0162 0132     
0126 0164 1606  10         JNE ELIAS_DONE                  ; If bit=1, done
0127                                                       ; Data bit was 0, continue
0128 0166 0A19  14         SLA R9, 1                       ; value <<= 1
0129 0168 06A0  20         BL @READBIT                     ; Read value bit
     016A 0132     
0130 016C 2BCC  14         XOR R12, R15                    ; possibly invert the one bit
0131 016E A24F  14         A R15, R9                       ; R15 is 1 or zero, add it
0132 0170 10F7  10         JMP ELIAS_LOOP
0133               ELIAS_DONE
0134 0172 045E  16         B *R14
                   < boot.a99
